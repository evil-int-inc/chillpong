import Char "mo:core/Char";
import Blob "mo:core/Blob";
import Map "mo:core/Map";
import Nat "mo:core/Nat";
import Principal "mo:core/Principal";
import Runtime "mo:core/Runtime";
import Text "mo:core/Text";
import Time "mo:core/Time";
import AccessControl "mo:caffeineai-authorization/access-control";
import { ic } "mo:ic";
import IC "mo:ic/Types";
import Calls "mo:ic/Call";
import Common "../types/common";
import Users "../types/users";
import Telegram "../types/telegram";
import RolesLib "../lib/roles";
import UsersLib "../lib/users";
import Verifier "../lib/telegram-verifier";

mixin (
  accessControlState : AccessControl.AccessControlState,
  users : Map.Map<Common.UserId, Users.User>,
  usernames : Map.Map<Text, Common.UserId>,
  owner : Common.OwnerState,
  telegramConfig : Telegram.ConfigState,
  telegramLinks : Map.Map<Common.UserId, Telegram.Link>,
  telegramOwners : Map.Map<Text, Common.UserId>,
  telegramChallenges : Map.Map<Common.UserId, Telegram.Challenge>,
  telegramCache : Telegram.CacheState,
) {
  func requireTelegramMember(caller : Principal) {
    if (caller.isAnonymous() or accessControlState.userRoles.get(caller) == null) {
      Runtime.trap("Unauthorized: Sign in to link Telegram");
    };
  };

  public query func getTelegramLinkConfig() : async Telegram.Config {
    { clientId = telegramConfig.clientId };
  };

  // A Login client ID is public. Bot tokens and client secrets must never be
  // stored on-chain; the popup flow supplies a publicly verifiable ID token.
  public shared ({ caller }) func setTelegramLinkConfig(clientId : ?Text) : async () {
    RolesLib.requireAdmin(accessControlState, caller);
    let normalized = switch (clientId) {
      case null { null };
      case (?value) {
        let trimmed = value.trim(#predicate(Char.isWhitespace));
        if (trimmed == "") { null } else {
          if (trimmed.size() > 16) { Runtime.trap("Invalid Telegram Login client ID") };
          for (c in trimmed.chars()) {
            if (c < '0' or c > '9') { Runtime.trap("Invalid Telegram Login client ID") };
          };
          // The SDK consumes a JavaScript number, so reject IDs it cannot
          // represent precisely and use the canonical nonzero decimal form.
          let parsed = switch (Nat.fromText(trimmed)) { case (?value) { value }; case null { Runtime.trap("Invalid Telegram Login client ID") } };
          if (parsed == 0 or parsed > 9_007_199_254_740_991) { Runtime.trap("Invalid Telegram Login client ID") };
          ?parsed.toText();
        };
      };
    };
    telegramConfig.clientId := normalized;
    telegramChallenges.clear();
    telegramCache.keys := null;
  };

  public query ({ caller }) func getCallerTelegramLink() : async ?Telegram.Link {
    if (caller.isAnonymous()) { return null };
    telegramLinks.get(caller);
  };

  public shared ({ caller }) func startTelegramLink() : async Telegram.LinkRequest {
    requireTelegramMember(caller);
    let clientId = telegramConfig.clientId ?? Runtime.trap("Telegram linking is not configured yet");
    let now = Time.now();
    switch (telegramChallenges.get(caller)) {
      case (?challenge) {
        if (now - challenge.createdAt < 5_000_000_000) { Runtime.trap("Wait a few seconds before trying Telegram again") };
      };
      case null {};
    };
    // The nonce is generated by the IC, bound to this principal, short-lived,
    // and consumed exactly once after verification. It is never client chosen.
    let random = await ic.raw_rand();
    requireTelegramMember(caller);
    if (telegramConfig.clientId != ?clientId) { Runtime.trap("Telegram configuration changed. Try linking again.") };
    let createdAt = Time.now();
    let challenge : Telegram.Challenge = {
      clientId;
      nonce = Verifier.base64UrlEncode(random);
      createdAt;
      expiresAt = createdAt + Verifier.challengeLifetime;
    };
    telegramChallenges.add(caller, challenge);
    // Expired challenges are bounded to active callers rather than retained
    // indefinitely across upgrades.
    for ((principal, value) in telegramChallenges.entries()) {
      if (value.expiresAt <= createdAt) { telegramChallenges.remove(principal) };
    };
    { clientId; nonce = challenge.nonce; expiresAt = challenge.expiresAt };
  };

  public query func telegramKeysTransform(args : { context : Blob; response : IC.HttpRequestResult }) : async IC.HttpRequestResult {
    let response = args.response;
    if (response.status != 200 or response.body.size() > Verifier.maxJwksBytes) {
      return { status = 502; headers = []; body = "Telegram verification keys unavailable" };
    };
    let ?body = response.body.decodeUtf8() else return { status = 502; headers = []; body = "Invalid Telegram verification keys" };
    switch (Verifier.canonicalKeys(body)) {
      case (#ok canonical) { { status = 200; headers = []; body = canonical.encodeUtf8() } };
      case (#err _) { { status = 502; headers = []; body = "Invalid Telegram verification keys" } };
    };
  };

  func fetchTelegramKeys() : async Text {
    let response = try {
      await Calls.httpRequest({
        url = Verifier.jwksUrl;
        method = #get;
        max_response_bytes = ?32_768;
        body = null;
        headers = [{ name = "Accept"; value = "application/json" }, { name = "Accept-Encoding"; value = "identity" }];
        transform = ?{ function = telegramKeysTransform; context = "" };
        is_replicated = ?true;
      });
    } catch (_) { Runtime.trap("Telegram verification is temporarily unavailable. Try again.") };
    if (response.status != 200) { Runtime.trap("Telegram verification is temporarily unavailable. Try again.") };
    let ?body = response.body.decodeUtf8() else Runtime.trap("Invalid Telegram verification keys");
    switch (Verifier.parseKeys(body)) { case (#ok _) {}; case (#err error) { Runtime.trap(error) } };
    telegramCache.keys := ?{ body; expiresAt = Time.now() + 3_600_000_000_000 };
    body;
  };

  func verificationKeys(kid : Text) : async [Verifier.RsaKey] {
    switch (telegramCache.keys) {
      case (?cache) {
        if (cache.expiresAt > Time.now()) {
          switch (Verifier.parseKeys(cache.body)) {
            case (#ok keys) { if (keys.any(func(key) = key.kid == kid)) { return keys } };
            case (#err _) {};
          };
          // A forged token with a changing kid must not trigger repeated paid
          // HTTPS requests. Allow rotation refreshes at most once per minute;
          // known, valid Telegram keys continue working during this interval.
          let fetchedAt = cache.expiresAt - 3_600_000_000_000;
          if (Time.now() - fetchedAt < 60_000_000_000) {
            Runtime.trap("Telegram verification key has changed. Try linking again.");
          };
        };
      };
      case null {};
    };
    switch (Verifier.parseKeys(await fetchTelegramKeys())) {
      case (#ok keys) { keys };
      case (#err error) { Runtime.trap(error) };
    };
  };

  public shared ({ caller }) func completeTelegramLink(idToken : Text) : async Users.User {
    requireTelegramMember(caller);
    let challenge = telegramChallenges.get(caller) ?? Runtime.trap("Start Telegram linking before submitting a token");
    if (telegramConfig.clientId != ?challenge.clientId) { Runtime.trap("Telegram configuration changed. Try linking again.") };
    let token = switch (Verifier.parseToken(idToken, challenge, Time.now())) {
      case (#ok token) { token };
      case (#err error) { Runtime.trap(error) };
    };
    let keys = await verificationKeys(token.kid);
    // The HTTPS outcall suspends this message. Recheck challenge/config and
    // time afterwards to prevent concurrent completion, expiry, or a new
    // linking request from reusing the old proof.
    requireTelegramMember(caller);
    if (telegramConfig.clientId != ?challenge.clientId or telegramChallenges.get(caller) != ?challenge) {
      Runtime.trap("Telegram link verification did not match. Try linking again.");
    };
    let currentToken = switch (Verifier.parseToken(idToken, challenge, Time.now())) {
      case (#ok current) { current };
      case (#err error) { Runtime.trap(error) };
    };
    let verified = switch (Verifier.verify(currentToken, keys)) {
      case (#ok claims) { claims };
      case (#err error) { Runtime.trap(error) };
    };
    switch (telegramOwners.get(verified.subject)) {
      case (?principal) {
        if (principal != caller) { Runtime.trap("This Telegram account is already linked to another member") };
      };
      case null {};
    };
    // Username collision validation precedes link mutation. A trap rolls back
    // this whole final message, preserving the old profile/link and nonce.
    let role = RolesLib.effectiveRole(accessControlState, users, owner, caller);
    let saved = UsersLib.setVerifiedTelegramUsername(users, usernames, caller, ?verified.username, role);
    switch (telegramLinks.get(caller)) {
      case (?old) { if (old.subject != verified.subject) { telegramOwners.remove(old.subject) } };
      case null {};
    };
    telegramLinks.add(caller, { subject = verified.subject; username = verified.username; linkedAt = Time.now() });
    telegramOwners.add(verified.subject, caller);
    telegramChallenges.remove(caller);
    { saved with role };
  };

  public shared ({ caller }) func unlinkTelegram() : async Users.User {
    requireTelegramMember(caller);
    switch (telegramLinks.get(caller)) {
      case (?link) { telegramOwners.remove(link.subject); telegramLinks.remove(caller) };
      case null {};
    };
    telegramChallenges.remove(caller);
    let user = users.get(caller) ?? Runtime.trap("User not found");
    { user with role = RolesLib.effectiveRole(accessControlState, users, owner, caller) };
  };
};
