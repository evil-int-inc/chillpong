type _ImmutableObjectStorageRefillResult =
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult =
 record {
   blob_hash: text;
   method: text;
 };
type Value =
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRoleView =
 record {
   displayName: text;
   id: UserId;
   role: opt Role;
   username: text;
 };
type UserRole =
 variant {
   admin;
   guest;
   user;
 };
type UserInput =
 record {
   bio: opt text;
   displayName: text;
   username: text;
 };
type UserId = principal;
type User =
 record {
   avatar: opt ExternalBlob;
   bio: opt text;
   createdAt: Timestamp;
   displayName: text;
   id: UserId;
   role: opt Role;
   username: text;
 };
type TournamentStatus =
 variant {
   completed;
   live;
   upcoming;
 };
type TournamentInput =
 record {
   capacity: nat;
   description: text;
   format: TournamentFormat;
   startsAt: Timestamp;
   status: TournamentStatus;
   title: text;
   venue: text;
 };
type TournamentFormat =
 variant {
   doubles;
   singles;
 };
type Tournament =
 record {
   capacity: nat;
   createdAt: Timestamp;
   description: text;
   format: TournamentFormat;
   id: nat;
   startsAt: Timestamp;
   status: TournamentStatus;
   title: text;
   updatedAt: Timestamp;
   venue: text;
 };
type Timestamp = int;
type Role = variant {admin;};
type Result__1 =
 variant {
   err: Error;
   ok;
 };
type Result =
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ExternalBlob = blob;
type Error =
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell =
 record {
   name: text;
   value: Value;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  bootstrapOwner: () -> ();
  createTournament: (input: TournamentInput) -> (Tournament);
  createUser: (userId: UserId, input: UserInput) -> (User);
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerProfile: () -> (opt User) query;
  getCallerUserRole: () -> (UserRole) query;
  getMyRole: () -> (opt Role) query;
  getTournament: (id: nat) -> (opt Tournament) query;
  getTournaments: () -> (vec Tournament) query;
  getUser: (userId: UserId) -> (opt User) query;
  getUserByUsername: (username: text) -> (opt User) query;
  grantAdminRole: (target: UserId) -> (UserRoleView);
  isCallerAdmin: () -> (bool) query;
  listUsers: () -> (vec User) query;
  listUsersWithRoles: () -> (vec UserRoleView) query;
  revokeAdminRole: (target: UserId) -> (UserRoleView);
  schema: () -> (text) query;
  updateTournament: (id: nat, input: TournamentInput) -> (Tournament);
  updateUser: (userId: UserId, input: UserInput) -> (User);
}
