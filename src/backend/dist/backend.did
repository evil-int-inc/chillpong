type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRoleView = 
 record {
   displayName: text;
   id: UserId;
   role: opt Role;
   username: text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserInput = 
 record {
   bio: opt text;
   displayName: text;
   username: text;
 };
type UserId = principal;
type User = 
 record {
   avatar: opt ExternalBlob;
   bio: opt text;
   createdAt: Timestamp;
   displayName: text;
   id: UserId;
   role: opt Role;
   username: text;
 };
type TournamentTableStatus = 
 variant {
   available;
   finished;
   playing;
   waiting;
 };
type TournamentTable = 
 record {
   matchId: opt nat;
   number: nat;
   status: TournamentTableStatus;
 };
type TournamentStatus = 
 variant {
   completed;
   live;
   upcoming;
 };
type TournamentState = 
 record {
   canUndo: bool;
   championId: opt nat;
   elimination: TournamentElimination;
   history: vec TournamentAction;
   matches: vec TournamentMatch;
   nextMatches: vec nat;
   players: vec TournamentPlayer;
   started: bool;
   tableCount: nat;
   tables: vec TournamentTable;
   tournamentId: nat;
   updatedAt: Timestamp;
   waitingQueue: vec nat;
 };
type TournamentSlot = 
 variant {
   a;
   b;
 };
type TournamentPlayerStatus = 
 variant {
   advanced;
   champion;
   eliminated;
   playing;
   ready;
   removed;
   waiting;
 };
type TournamentPlayer = 
 record {
   currentMatchId: opt nat;
   id: nat;
   losses: nat;
   name: text;
   registeredAt: Timestamp;
   registrationNumber: nat;
   seed: opt nat;
   skillLevel: nat;
   status: TournamentPlayerStatus;
   table: opt nat;
 };
type TournamentMatchStatus = 
 variant {
   blocked;
   bye;
   cancelled;
   completed;
   playing;
   ready;
 };
type TournamentMatch = 
 record {
   bracket: TournamentBracket;
   id: nat;
   loserId: opt nat;
   manualOverride: bool;
   playerA: opt nat;
   playerB: opt nat;
   position: nat;
   priority: int;
   round: nat;
   scoreA: opt nat;
   scoreB: opt nat;
   sourceA: MatchSource;
   sourceB: MatchSource;
   status: TournamentMatchStatus;
   table: opt nat;
   winnerId: opt nat;
 };
type TournamentInput = 
 record {
   capacity: nat;
   description: text;
   format: TournamentFormat;
   startsAt: Timestamp;
   status: TournamentStatus;
   title: text;
   venue: text;
 };
type TournamentFormat = 
 variant {
   doubles;
   singles;
 };
type TournamentElimination = 
 variant {
   doubleElimination;
   singleElimination;
 };
type TournamentCommand = 
 variant {
   addPlayer: record {
                name: text;
                skillLevel: nat;
              };
   assignBye: record {
                matchId: nat;
                slot: TournamentSlot;
              };
   assignTable: record {
                  matchId: nat;
                  table: opt nat;
                };
   configure: record {
                elimination: TournamentElimination;
                tableCount: nat;
              };
   editPlayer: record {
                 name: text;
                 playerId: nat;
                 skillLevel: nat;
               };
   generateBracket;
   movePlayer: record {
                 matchId: nat;
                 playerId: nat;
                 slot: TournamentSlot;
               };
   placePlayer: record {
                  matchId: nat;
                  playerId: nat;
                  slot: TournamentSlot;
                };
   prioritizeMatch: nat;
   prioritizePlayer: nat;
   recordResult: record {
                   matchId: nat;
                   scoreA: nat;
                   scoreB: nat;
                 };
   removePlayer: record {
                   confirmed: bool;
                   playerId: nat;
                 };
   resetMatch: record {
                 cascade: bool;
                 matchId: nat;
               };
   setMatchPlayers: record {
                      matchId: nat;
                      playerA: opt nat;
                      playerB: opt nat;
                    };
   startMatch: nat;
   swapPlayers:
    record {
      firstMatchId: nat;
      firstSlot: TournamentSlot;
      secondMatchId: nat;
      secondSlot: TournamentSlot;
    };
   undo;
 };
type TournamentBracket = 
 variant {
   grandFinal;
   losers;
   resetFinal;
   winners;
 };
type TournamentAction = 
 record {
   caption: text;
   createdAt: Timestamp;
   id: nat;
 };
type Tournament = 
 record {
   capacity: nat;
   createdAt: Timestamp;
   description: text;
   format: TournamentFormat;
   id: nat;
   startsAt: Timestamp;
   status: TournamentStatus;
   title: text;
   updatedAt: Timestamp;
   venue: text;
 };
type Timestamp = int;
type Role = variant {admin;};
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ProfileInput = 
 record {
   displayName: text;
   username: text;
 };
type MatchSource = 
 variant {
   bye;
   loser: nat;
   player: nat;
   winner: nat;
 };
type ExternalBlob = blob;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  applyTournamentCommand: (id: nat, command: TournamentCommand) ->
   (TournamentState);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  bootstrapOwner: () -> ();
  createTournament: (input: TournamentInput) -> (Tournament);
  createUser: (userId: UserId, input: UserInput) -> (User);
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerProfile: () -> (opt User) query;
  getCallerUserRole: () -> (UserRole) query;
  getMyRole: () -> (opt Role) query;
  getTournament: (id: nat) -> (opt Tournament) query;
  getTournamentState: (id: nat) -> (opt TournamentState) query;
  getTournaments: () -> (vec Tournament) query;
  getUser: (userId: UserId) -> (opt User) query;
  getUserByUsername: (username: text) -> (opt User) query;
  grantAdminRole: (target: UserId) -> (UserRoleView);
  isCallerAdmin: () -> (bool) query;
  listUsers: () -> (vec User) query;
  listUsersWithRoles: () -> (vec UserRoleView) query;
  revokeAdminRole: (target: UserId) -> (UserRoleView);
  saveCallerProfile: (input: ProfileInput) -> (User);
  schema: () -> (text) query;
  updateTournament: (id: nat, input: TournamentInput) -> (Tournament);
  updateUser: (userId: UserId, input: UserInput) -> (User);
}
